# Environment variables for Citi Bike ingestion pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=citi_bike
POSTGRES_PASSWORD=citi_bike_dev
POSTGRES_DB=citi_bike

# Data settings
DATA_DIR=./data
CACHE_DIR=./data/cache
LOG_LEVEL=INFO
DEFAULT_MONTH=202601

# Ingestion settings
BATCH_SIZE=50000
RETRY_ATTEMPTS=3
RETRY_DELAY=2.0
